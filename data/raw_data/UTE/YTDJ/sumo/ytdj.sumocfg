<configuration>
    <input>
        <net-file    value="ytdj.net.xml"/>
        <route-files value="ytdj.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end   value="545"/>
    </time>
    <processing>
        <ignore-route-errors value="true"/>
    </processing>
    <report>
        <no-warnings value="false"/>
        <verbose      value="false"/>
    </report>
</configuration>
